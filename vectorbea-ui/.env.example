# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — Supabase dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon/public key — safe to expose to the browser (enforces RLS)
# Supabase dashboard → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — SERVER ONLY, never prefix with NEXT_PUBLIC_
# Supabase dashboard → Settings → API → service_role secret
# Used by Next.js API routes to verify sessions and write to DB as admin.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── VectorBea Backend (Kotlin API) ────────────────────────────────────────────
# Public URL of the deployed Kotlin backend.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: internal/private URL for server-side API route calls only.
# Falls back to NEXT_PUBLIC_API_URL when unset.
API_URL=http://localhost:8080

# API key used as Bearer token when Next.js API routes call the Kotlin backend.
# Generate from VectorBea dashboard → API Keys.
# SERVER ONLY — do not prefix with NEXT_PUBLIC_.
VECTORBEA_API_KEY=vb_your_key_here

# ── Billing ───────────────────────────────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
NEXT_PUBLIC_BILLING_PORTAL_URL=

# ── Middleware IP Allowlist ────────────────────────────────────────────────────
# Comma-separated IPs allowed on preview/development deployments.
# Not needed for production — the check is skipped when VERCEL_ENV=production.
WHITELISTED_IPS=
