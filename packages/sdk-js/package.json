{
  "name": "@vectorbea-ai/node",
  "version": "0.2.8",
  "private": true,
  "description": "Internal Node.js / TypeScript SDK for Vectorbea (legacy — not published)",
  "license": "MIT",
  "author": "VectorBea <support@vectorbea.com>",
  "homepage": "https://vectorbea.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susmitbanerjee/vectorbea.git"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "scan": "bash scripts/scan-secrets.sh"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "vectorbea",
    "llm",
    "prompt",
    "ai",
    "sdk",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
