# =============================================================================
# Vectorbea — Root environment variables
#
# Copy to .env before running docker compose:
#   cp .env.example .env
#
# For native local dev, also copy service-specific examples:
#   cp apps/web/.env.example              apps/web/.env.local
#   cp apps/api-kotlin/.env.example       apps/api-kotlin/.env
#   cp apps/worker-kotlin/.env.example    apps/worker-kotlin/.env
#
# NEVER commit .env to git.
# =============================================================================

# ── Infrastructure ports (docker compose only) ────────────────────────────────
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
WORKER_METRICS_PORT=9090
WEB_PORT=3000

# ── Kotlin API + Worker — database connection ─────────────────────────────────
# JDBC URL format (used by HikariCP in the Kotlin services).
# Local native dev: jdbc:postgresql://localhost:5432/vectorbea
# Docker full-stack: the compose file overrides this to use the service name.
DATABASE_URL=jdbc:postgresql://localhost:5432/vectorbea

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Next.js — Prisma connection strings ──────────────────────────────────────
# Prisma uses its own postgresql:// URL format.
# These are only consumed by apps/web — copy them to apps/web/.env.local too.
DATABASE_URL_PRISMA=postgresql://vectorbea:vectorbea@localhost:5432/vectorbea?schema=vectorbea
DIRECT_URL=postgresql://vectorbea:vectorbea@localhost:5432/vectorbea?schema=vectorbea

# ── Kotlin API URL (used by Next.js frontend) ─────────────────────────────────
# Local native dev: http://localhost:8080
# Docker full-stack mode: set to http://api:8080 inside docker-compose.yml
NEXT_PUBLIC_VECTORBEA_API_URL=http://localhost:8080

# ── Public site origin (SEO) ──────────────────────────────────────────────────
# Used for canonical URLs, OpenGraph and sitemap.xml. Always the production
# HTTPS domain, even in preview/dev (defaults to https://vectorbea.com).
# Override only for a self-hosted fork on a different domain.
NEXT_PUBLIC_SITE_URL=https://vectorbea.com

# ── Secret encryption key ─────────────────────────────────────────────────────
# AES-256 key: must be a Base64 string that decodes to EXACTLY 32 bytes.
# Generate a real key for local dev or production:
#   openssl rand -base64 32
# The value below is a valid 32-byte dev placeholder — never use in production.
SECRET_ENCRYPTION_KEY=ZGV2LWtleS1mb3ItbG9jYWwtZGV2LW9ubHktMzJi
SECRET_KEY_VERSION=1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins the Kotlin API accepts.
# Production: set to your Vercel deployment URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Auth (Supabase) ───────────────────────────────────────────────────────────
# Leave as placeholders to run in open/mock-session mode (no login required).
# Set real values + REQUIRE_AUTH=true to enable production authentication.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REQUIRE_AUTH=false

# ── Open / mock-session mode (local dev without auth) ────────────────────────
MOCK_ORG_ID=org_acme_vectorbea_seed
MOCK_USER_ID=user_seed_owner_vectorbea

# ── Worker tuning ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Billing (LemonSqueezy) — optional ─────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
NEXT_PUBLIC_BILLING_PORTAL_URL=

# ── Email (Resend) — optional ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@vectorbea.com

# ── Support portal (/support) ────────────────────────────────────────────────
# Comma-separated emails allowed into the admin support portal at /support and
# notified when a customer files a ticket. Falls back to a built-in default if
# unset. (Legacy single-admin SUPPORT_EMAIL is still honored for compatibility.)
SUPPORT_ADMIN_EMAILS=susmit.b1@gmail.com,susmit@vectorbea.com

# ── Slack notifications — optional ───────────────────────────────────────────
SLACK_WEBHOOK_URL=
