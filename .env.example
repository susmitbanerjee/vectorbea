# =============================================================================
# Vectorbea Agent Scheduler — Root environment variables
#
# Used by:
#   - docker compose (web + worker services read this file)
#   - apps/web       (copy to apps/web/.env.local for native dev)
#   - apps/worker    (copy to apps/worker/.env for native dev)
#
# Quick start:
#   cp .env.example .env
#   # Edit the values below, then:
#   docker compose up postgres redis -d
#   npm run db:migrate && npm run db:seed && npm run dev
# =============================================================================

# ── Database (PostgreSQL via Prisma) ─────────────────────────────────────────
# Local Docker Postgres (default):
DATABASE_URL=postgresql://vectorbea:vectorbea@localhost:5432/vectorbea
# Required by Prisma for schema migrations (must be a direct connection, not pooled)
DIRECT_URL=postgresql://vectorbea:vectorbea@localhost:5432/vectorbea
#
# Neon (serverless Postgres — recommended for Vercel deployment):
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/vectorbea?sslmode=require
# DIRECT_URL=postgresql://<user>:<password>@<host>.neon.tech/vectorbea?sslmode=require

# ── Redis (BullMQ job queue backend) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth (Supabase) ───────────────────────────────────────────────────────────
# Leave these as placeholders to run in "open/mock-session" mode (no login needed).
# Set real values + REQUIRE_AUTH=true to enable production auth.
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to "true" to enforce Supabase authentication on all API routes
REQUIRE_AUTH=false

# ── Open / mock-session mode (local dev without auth) ────────────────────────
# When NEXT_PUBLIC_SUPABASE_URL is the placeholder above (or unset) and
# REQUIRE_AUTH is false, every request resolves to the seeded acme-corp org.
# Override these if you changed the seed data.
MOCK_ORG_ID=org_acme_vectorbea_seed
MOCK_USER_ID=user_seed_owner_vectorbea

# ── Internal API security ─────────────────────────────────────────────────────
# Shared secret for worker → web callbacks and cron trigger endpoints.
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=dev-secret-change-in-production

# ── Billing (LemonSqueezy) — optional ─────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
NEXT_PUBLIC_BILLING_PORTAL_URL=

# ── Email (Resend) — optional ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@vectorbea.com

# ── Slack notifications — optional ───────────────────────────────────────────
SLACK_WEBHOOK_URL=
