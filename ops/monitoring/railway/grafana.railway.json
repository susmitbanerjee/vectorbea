{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops/monitoring/railway/grafana.Dockerfile",
    "watchPatterns": [
      "ops/monitoring/grafana/**",
      "ops/monitoring/railway/grafana-entrypoint.sh",
      "ops/monitoring/railway/grafana.Dockerfile"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30
  }
}
