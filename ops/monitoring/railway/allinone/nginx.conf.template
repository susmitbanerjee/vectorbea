# The single public port, routed by path.
#
# ── THIS FILE IS THE SECURITY BOUNDARY ───────────────────────────────────────
# In the six-service layout, Prometheus was protected by not having a domain: there
# was no route to it from the internet, and there was nothing to misconfigure.
#
# Here everything shares one container and one public port, so that protection becomes
# an ACTIVE decision instead of an absence. Prometheus' query API has no authentication
# and can read every series including per-workspace cost; Alertmanager's API can
# silence any alert; Tempo holds run and agent names. None of them may be reachable.
#
# They are safe because this file routes to exactly two upstreams and nothing else,
# AND because each of them binds 127.0.0.1 (see supervisord.conf). Two independent
# reasons, because one edit to this file should not be enough to expose a database.
#
# `__PORT__` is substituted at startup — nginx does not expand environment variables.

worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events { worker_connections 512; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Railway already logs every request at the edge; a second copy in the container
    # is noise that competes with the application logs actually worth reading.
    access_log off;

    # Traces and metric batches are large. The default 1m would reject a busy agent's
    # push with a 413 that reads, on the agent side, as an unexplained export failure.
    client_max_body_size 32m;

    # Grafana's live features use websockets; without the upgrade headers they fail
    # silently and dashboards stop auto-refreshing. `close` for ordinary requests.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # ── EVERY proxy_set_header LIVES HERE, AND ONLY HERE ─────────────────────────
    # nginx inherits proxy_set_header from this level into a location ONLY IF that
    # location sets none of its own. The Grafana location used to set Upgrade and
    # Connection, which silently dropped Host: Grafana saw `Host: grafana`, the
    # browser's Origin said telemetry.vectorbea.com, and Grafana's CSRF check refused
    # every cookie-authenticated POST — "Login failed: origin not allowed", and every
    # dashboard query with it. scripts/monitoring/validate.mjs fails on a location
    # block that sets a header.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    upstream grafana   { server 127.0.0.1:3000; }
    upstream collector { server 127.0.0.1:4318; }

    server {
        listen __PORT__;
        server_name _;

        # ── OTLP ingest ──────────────────────────────────────────────────────
        # The only non-Grafana route. `/v1/metrics` and `/v1/traces` are the paths
        # the OTLP/HTTP exporter appends to its configured endpoint, so an agent
        # pointed at this domain reaches the collector and nothing else.
        #
        # The collector requires a bearer token of its own — this route is not the
        # authentication, it is only the path.
        location /v1/ {
            proxy_pass http://collector;
            proxy_read_timeout 60s;
        }

        # ── Explicit refusals ────────────────────────────────────────────────
        # Everything else falls through to Grafana, and Grafana 404s an unknown path
        # — so these blocks are not load-bearing. They exist because a future edit
        # that adds a route is much more likely to be noticed as wrong when the file
        # already says, in words, that these must never be exposed.
        location /prometheus { return 404; }
        location /alertmanager { return 404; }
        location /tempo { return 404; }
        location /loki { return 404; }
        # Prometheus' remote-write endpoint. Reachable only from inside the container,
        # and named here so nobody adds it thinking it is needed for ingest — it is
        # not: agents send OTLP to /v1/, and the collector writes to Prometheus over
        # loopback.
        location /api/v1/write { return 404; }

        # ── Everything else is Grafana ───────────────────────────────────────
        # No proxy_set_header in here — see the note at the top of `http`.
        location / {
            proxy_pass http://grafana;
            proxy_read_timeout 300s;
        }
    }
}
