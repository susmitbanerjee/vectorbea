{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops/monitoring/railway/alertmanager.Dockerfile",
    "watchPatterns": [
      "ops/monitoring/alertmanager/**",
      "ops/monitoring/railway/alertmanager.Dockerfile"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/-/healthy",
    "healthcheckTimeout": 30
  }
}
