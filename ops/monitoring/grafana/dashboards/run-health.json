{
  "uid": "vb-run-health",
  "title": "Run health",
  "description": "Are runs succeeding, and how long do they take? Fleet health answers whether the machine is coping; this answers whether the work is any good.",
  "tags": [
    "vectorbea",
    "runs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Success rate (1h)",
      "description": "Succeeded over succeeded+failed. Cancelled runs are excluded — a user cancelling is not the system failing, and counting it as one makes the number lie in the reassuring direction.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(worker_workflow_runs_succeeded_total{environment=~\"$env\"}[1h])) / clamp_min(sum(increase(worker_workflow_runs_succeeded_total{environment=~\"$env\"}[1h])) + sum(increase(worker_workflow_runs_failed_total{environment=~\"$env\"}[1h])), 1)",
          "legendFormat": "success rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Throughput",
      "description": "Runs completing per minute, by outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(worker_workflow_runs_succeeded_total{environment=~\"$env\"}[5m])) * 60",
          "legendFormat": "succeeded/min"
        },
        {
          "expr": "sum(rate(worker_workflow_runs_failed_total{environment=~\"$env\"}[5m])) * 60",
          "legendFormat": "failed/min"
        },
        {
          "expr": "sum(rate(worker_workflow_runs_cancelled_total{environment=~\"$env\"}[5m])) * 60",
          "legendFormat": "cancelled/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "How long does work take?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Node duration — p50 / p95 / p99",
      "description": "Per NODE, not per run. Whole-run duration conflates 'the model was slow' with 'this workflow has forty steps'; this identifies which step is slow.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(job_execution_duration_seconds_bucket{environment=~\"$env\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(job_execution_duration_seconds_bucket{environment=~\"$env\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(job_execution_duration_seconds_bucket{environment=~\"$env\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0
          }
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "p95 by node kind",
      "description": "Which kind of step is slow. An llm node at 20s is a model; a db_query node at 20s is a customer's database and a different conversation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, node_kind) (rate(job_execution_duration_seconds_bucket{environment=~\"$env\"}[5m])))",
          "legendFormat": "{{node_kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Why do runs fail?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Node outcomes",
      "description": "Timeouts are separated from errors deliberately: a timeout means the work was too slow, an error means it was wrong, and they lead to different fixes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(job_execution_duration_seconds_count{environment=~\"$env\", outcome!=\"ok\"}[5m]) * 60)",
          "legendFormat": "{{outcome}}/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Degradation guards firing",
      "description": "The system protecting itself: circuits opening, tenants throttled, provider 429s, per-run ceilings hit. Activity here is the system working as designed — but sustained activity means users are hitting limits.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(circuit_opened_total{environment=~\"$env\"}[5m]) * 60)",
          "legendFormat": "circuits opened/min"
        },
        {
          "expr": "sum(rate(tenant_throttled_total{environment=~\"$env\"}[5m]) * 60)",
          "legendFormat": "tenants throttled/min"
        },
        {
          "expr": "sum by (provider) (rate(provider_429_total{environment=~\"$env\"}[5m]) * 60)",
          "legendFormat": "429 {{provider}}/min"
        },
        {
          "expr": "sum(rate(run_ceiling_breach_total{environment=~\"$env\"}[5m]) * 60)",
          "legendFormat": "ceilings hit/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 23,
      "type": "logs",
      "title": "Recent failures",
      "description": "Errors from both services. Each line carries run_id and node_id; the trace_id links straight to the trace. NOTE: log shipping is not yet wired on Railway — Promtail reads the Docker socket, which Railway does not expose. This panel is correct and will populate once a log drain is configured; until then it is empty. See docs/telemetry/deployment.md.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "expr": "{environment=\"$env\", level=~\"ERROR|WARN\"} | json | line_format \"{{.run_id}} {{.node_id}} {{.message}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(job_last_success_timestamp_seconds, environment)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "prod",
          "value": "prod"
        }
      }
    ]
  }
}
