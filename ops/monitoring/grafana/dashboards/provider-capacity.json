{
  "uid": "vb-provider-capacity",
  "title": "Provider capacity",
  "description": "Everything about how the platform spends its model-provider budget: what the providers refuse, what we refuse ourselves, and whether the local bucket is sized to match reality. Audience: whoever is on call for throughput.",
  "tags": [
    "vectorbea",
    "provider",
    "capacity"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(job_last_success_timestamp_seconds, environment)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "prod",
          "value": "prod"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Are we being refused, and by whom?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "429s received, by provider",
      "description": "The provider refusing US. Read together with the panel to its right: 429s climbing while local refusals stay flat means our bucket is set above the provider's real limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (provider, model) (rate(provider_429_received_total{environment=~\"$env\"}[5m]) * 60)",
          "refId": "A",
          "legendFormat": "{{provider}} / {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Bucket refusals, by provider",
      "description": "US refusing ourselves BEFORE the request. This is the bucket working. It is deliberately not alerted — alerting on it would punish the mechanism for doing its job.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (provider, model) (rate(provider_capacity_exhausted_total{environment=~\"$env\"}[5m]) * 60)",
          "refId": "A",
          "legendFormat": "{{provider}} / {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "429 after admit — bucket bugs",
      "description": "A 429 that arrived on a call the bucket had ALREADY ADMITTED. Any non-zero value is a bug in the bucket, not a provider problem: the configured limit is above the real one, the estimate was short, or something outside this fleet is spending the same account's budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum(increase(provider_429_after_admit_total{environment=~\"$env\"}[1h]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Runs suspended by a 429",
      "description": "A suspension is the good outcome of a 429 — the run releases its permit instead of holding a worker slot while it sleeps.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 18,
        "x": 6,
        "y": 9
      },
      "targets": [
        {
          "expr": "sum by (provider) (rate(provider_429_total{environment=~\"$env\"}[5m]) * 60)",
          "refId": "A",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Is the bucket sized correctly?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Bucket fill at reserve time (p50 / p95)",
      "description": "How full the bucket was when a reservation was granted. Sitting near 1.0 means we are permanently at the ceiling and the limit is the binding constraint on throughput. Sitting near 0 means the bucket is not doing anything.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(provider_capacity_utilisation_bucket{environment=~\"$env\"}[5m])))",
          "refId": "A",
          "legendFormat": "p50 {{provider}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(provider_capacity_utilisation_bucket{environment=~\"$env\"}[5m])))",
          "refId": "A",
          "legendFormat": "p95 {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Estimate error — actual / reserved tokens",
      "description": "1.0 is a perfect estimate. ABOVE 1.0 is under-reservation, which is the direction that causes 429s. Watch p95 rather than the mean — a mean near 1.0 routinely hides a p95 of 1.4, and it is the p95 calls that breach the limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, model) (rate(provider_estimate_error_ratio_bucket{environment=~\"$env\"}[10m])))",
          "refId": "A",
          "legendFormat": "p50 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(provider_estimate_error_ratio_bucket{environment=~\"$env\"}[10m])))",
          "refId": "A",
          "legendFormat": "p95 {{model}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, model) (rate(provider_estimate_error_ratio_bucket{environment=~\"$env\"}[10m])))",
          "refId": "A",
          "legendFormat": "p99 {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Reservations and leaks",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Reservations granted, by lane",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (provider, lane) (rate(provider_capacity_reserved_total{environment=~\"$env\"}[5m]) * 60)",
          "refId": "A",
          "legendFormat": "{{provider}} / {{lane}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Reservations reclaimed by TTL — leaks",
      "description": "A reservation returned by its TTL rather than by settling. Expected to be near zero. Non-zero means workers are dying mid-call — survivable by design, but until the TTL fires that capacity is unavailable to everyone on the account.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(provider_capacity_leases_expired_total{environment=~\"$env\"}[5m]) * 60)",
          "refId": "A",
          "legendFormat": "leaked/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Circuit breakers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Circuit transitions",
      "description": "Opening is a provider or connection incident, not a platform one. Which connection is open is in `connections.circuit_state` — deliberately not a label here, because connection ids are unbounded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(rate(circuit_opened_total{environment=~\"$env\"}[5m]) * 60)",
          "refId": "A",
          "legendFormat": "opened/min"
        },
        {
          "expr": "sum(rate(circuit_closed_total{environment=~\"$env\"}[5m]) * 60)",
          "refId": "A",
          "legendFormat": "recovered/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Calls rejected fast by an open circuit",
      "description": "The win being measured: each one is a call that failed in microseconds instead of burning a 30s socket timeout and a worker permit with it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(rate(circuit_rejected_total{environment=~\"$env\"}[5m]) * 60)",
          "refId": "A",
          "legendFormat": "rejected/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    }
  ]
}
