{
  "uid": "vb-workspace-support",
  "title": "Workspace support",
  "description": "One customer at a time: what they are running, what it costs, and what the platform is doing to them. Built for answering a support question, not for watching.",
  "tags": [
    "vectorbea",
    "support"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(job_last_success_timestamp_seconds, environment)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "prod",
          "value": "prod"
        }
      },
      {
        "name": "workspace",
        "label": "Workspace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(tenant_active_runs{environment=~\"$env\"}, workspace)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Queued",
      "description": "Runs enqueued and not yet claimed for this workspace.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(job_queue_depth{environment=~\"$env\", workspace=\"$workspace\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "In flight",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(tenant_active_runs{environment=~\"$env\", workspace=\"$workspace\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Spend, last 24h",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(llm_cost_usd_micros_total{environment=~\"$env\", workspace=\"$workspace\"}[24h])) / 1e6",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Admission refusals, 1h",
      "description": "Times this workspace was refused admission for exceeding its own concurrency cap. Non-zero is not a fault — it is the fairness limiter doing its job — but it IS the answer to 'why are my runs slow'.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(tenant_throttled_total{environment=~\"$env\", workspace=\"$workspace\"}[1h]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Over time",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queue depth and in-flight",
      "description": "If queued climbs while in-flight sits flat at the cap, this workspace is limited by its OWN concurrency ceiling, not by the platform.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum(job_queue_depth{environment=~\"$env\", workspace=\"$workspace\"})",
          "refId": "A",
          "legendFormat": "queued"
        },
        {
          "expr": "sum(tenant_active_runs{environment=~\"$env\", workspace=\"$workspace\"})",
          "refId": "A",
          "legendFormat": "in flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Spend rate",
      "description": "Dollars per hour, by model. This is the panel the cost-anomaly alert points at.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum by (model) (rate(llm_cost_usd_micros_total{environment=~\"$env\", workspace=\"$workspace\"}[10m])) * 3600 / 1e6",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Ceiling breaches",
      "description": "NOTE: run_ceiling_breach carries no workspace label — this is fleet-wide. Correlate by time with the panels above rather than reading it as this customer's alone.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "sum by (dimension) (increase(run_ceiling_breach_total{environment=~\"$env\"}[1h]))",
          "refId": "A",
          "legendFormat": "{{dimension}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Throttling and refusals",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(tenant_throttled_total{environment=~\"$env\", workspace=\"$workspace\"}[5m]) * 60)",
          "refId": "A",
          "legendFormat": "{{reason}}"
        },
        {
          "expr": "sum by (class) (rate(tenant_claim_rejected_total{environment=~\"$env\", workspace=\"$workspace\"}[5m]) * 60)",
          "refId": "A",
          "legendFormat": "claim rejected {{class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "What this customer did",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Recent events",
      "description": "The product event stream for this workspace, joined by eye to the metric panels above. Answers 'what did they actually do' rather than 'what did the platform do to them'.",
      "datasource": {
        "type": "postgres",
        "uid": "analytics"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "rawSql": "SELECT occurred_at AS \"When\", event_name AS \"Event\",\n       event_category AS \"Category\", run_id AS \"Run\", workflow_id AS \"Workflow\"\n  FROM analytics_events\n WHERE environment = '$env'\n   AND workspace_id = '$workspace'::uuid\n   AND $__timeFilter(occurred_at)\n ORDER BY occurred_at DESC LIMIT 200",
          "format": "table",
          "rawQuery": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    }
  ]
}
