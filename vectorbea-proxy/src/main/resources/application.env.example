# ─── VectorBea Proxy — Environment Configuration ──────────────────────────────
#
# Copy this file to .env (or supply these as real env vars in Docker/Kubernetes).
# Never commit a .env file with real values.

# Required: URL of the VectorBea control plane hub.
# Production:  VECTORBEA_HUB_URL=https://dev.vectorbea.com
# Local dev:   VECTORBEA_HUB_URL=http://localhost:3000
VECTORBEA_HUB_URL=https://dev.vectorbea.com

# Required: Workspace API key generated from the VectorBea dashboard.
# Dashboard → API Keys → Create Key → copy the full vb_live_... or vb_test_... value.
# This key authenticates the proxy to the hub for prompt sync, heartbeat, and audit flush.
# Format: vb_live_<random> (production) or vb_test_<random> (non-production)
VECTORBEA_KEY=vb_live_replace_with_your_key

# Optional: HTTP port for the proxy's public endpoint (default: 8080)
VECTORBEA_HTTP_PORT=8080

# Optional: Path to shared rules/config file (default: /app/shared-config/rules.json)
VECTORBEA_SHARED_RULES_PATH=/app/shared-config/rules.json

# Optional: Stable host ID sent in heartbeats (default: HOSTNAME env var or machine hostname)
# In Kubernetes, HOSTNAME is set automatically to the pod name. Set explicitly for VMs.
VECTORBEA_HOST_ID=my-sidecar-pod-name

# Optional: Deployment environment reported in telemetry. Values: dev | prod (default: prod)
VECTORBEA_ENV=prod

# Optional: Separate telemetry ingest URL. Falls back to VECTORBEA_HUB_URL if not set.
# VECTORBEA_TELEMETRY_URL=https://telemetry.vectorbea.com

# Optional: Enable telemetry push (auto-enabled if VECTORBEA_TELEMETRY_URL is set)
# VECTORBEA_ENABLE_TELEMETRY=true

# Optional: Unix socket paths for local IPC (SDK clients in the same pod)
# VECTORBEA_REST_SOCKET=/run/vectorbea/rest.sock
# VECTORBEA_GRPC_SOCKET=/run/vectorbea/grpc.sock
