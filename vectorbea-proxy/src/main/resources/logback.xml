<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- VectorBea proxy — INFO so startup/shutdown messages are visible -->
  <logger name="com.vectorbea.proxy" level="INFO" additivity="false">
    <appender-ref ref="STDOUT" />
  </logger>

  <!-- Suppress noisy framework logs -->
  <logger name="io.ktor" level="WARN" />
  <logger name="io.grpc" level="WARN" />
  <logger name="org.eclipse.jetty" level="WARN" />

  <!-- Root — WARN to suppress debug noise from libraries -->
  <root level="WARN">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
