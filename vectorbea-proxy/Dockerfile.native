# syntax=docker/dockerfile:1.7

# ── Stage 1: GraalVM native-image compile ────────────────────────────────────
#
# Layer order is deliberate:
#   1. Install OS tools (findutils for xargs used by gradlew bootstrap)
#   2. Copy Gradle wrapper + build files ONLY — dep downloads are cached here
#   3. Pre-fetch all runtime dependencies with a no-op task so this heavy layer
#      survives source-only changes (the common case)
#   4. Copy sources — changing .kt / .proto files reuses the layer above
#   5. Run nativeCompile — always executes but skips re-downloading deps
#
# With GitHub Actions GHA layer cache this means a typical source-only push
# skips steps 1-3 entirely and jumps straight to the ~10-min native-image step.

FROM ghcr.io/graalvm/native-image-community:21 AS builder

WORKDIR /workspace

RUN microdnf install -y findutils && microdnf clean all

# Build metadata — cached unless wrapper or build config changes
COPY gradle gradle
COPY gradlew gradlew.bat build.gradle.kts settings.gradle.kts ./
COPY proguard-rules.pro ./
RUN chmod +x gradlew

# Pre-warm the Gradle dependency cache. The `dependencies` task resolves and
# downloads every artifact declared in build.gradle.kts without touching src.
# A source-only change reuses this layer and skips all downloads (~1-2 min).
RUN ./gradlew --no-daemon dependencies -q 2>&1 | tail -5 || true

# Application sources (Kotlin + proto) — copied after deps to maximise cache hits
COPY src src

# nativeCompile: generateProto → compileKotlin → native-image
RUN ./gradlew --no-daemon nativeCompile


# ── Stage 2: minimal runtime image ───────────────────────────────────────────
#
# debian:bookworm-slim provides glibc which the native binary was linked against.
# No JVM needed — the binary is fully self-contained.

FROM debian:bookworm-slim AS runner

WORKDIR /app

RUN groupadd -r vectorbea && useradd -r -g vectorbea vectorbea

COPY --from=builder /workspace/build/native/nativeCompile/vectorbea-proxy /app/vectorbea-proxy

RUN mkdir -p /run/vectorbea && chown vectorbea:vectorbea /run/vectorbea

USER vectorbea

ENTRYPOINT ["/app/vectorbea-proxy"]
