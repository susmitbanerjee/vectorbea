# ── Supabase ──────────────────────────────────────────────────────────────────
# Same project as vectorbea-ui — uses the service_role key for all reads and
# for token validation against vectorbea.deployment_agents.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# ── Business KPIs ─────────────────────────────────────────────────────────────
# Per-seat price used for MRR / ARR calculations.
SEAT_PRICE_USD=19.99

# ── Auth note ─────────────────────────────────────────────────────────────────
# There is NO separate TELEMETRY_INGEST_KEY.
# The /api/ingest route validates Bearer tokens against vectorbea.deployment_agents.api_token
# — the same credential the Kotlin sidecar already uses for prompt fetches.
# Set VECTORBEA_KEY on the sidecar and register the agent in the dashboard; no
# extra secrets need to be distributed.
