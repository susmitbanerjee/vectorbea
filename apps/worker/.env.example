# =============================================================================
# Vectorbea Worker — environment variables
#
# Copy to .env for local native development:
#   cp apps/worker/.env.example apps/worker/.env
#
# When running via docker compose, the root .env file is used instead.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vectorbea:vectorbea@localhost:5432/vectorbea

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Web app base URL (for resume callbacks after approval) ───────────────────
APP_URL=http://localhost:3000

# ── Internal API secret (must match apps/web INTERNAL_API_SECRET) ────────────
INTERNAL_API_SECRET=dev-secret-change-in-production

# ── Logging ───────────────────────────────────────────────────────────────────
NODE_ENV=development
