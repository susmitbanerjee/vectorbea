<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Read log level from env; default to INFO -->
  <property name="LOG_LEVEL" value="${LOG_LEVEL:-INFO}"/>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- Structured single-line format: timestamp level logger - message -->
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Access log (request/response lines) -->
  <logger name="vectorbea.access" level="${LOG_LEVEL}" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>

  <!-- Application loggers -->
  <logger name="com.vectorbea" level="${LOG_LEVEL}" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>

  <!-- Silence noisy JDK HttpServer internals -->
  <logger name="com.sun.net.httpserver" level="WARN"/>

  <!-- HikariCP — only log warnings by default -->
  <logger name="com.zaxxer.hikari" level="WARN"/>

  <!-- Lettuce — only log warnings by default -->
  <logger name="io.lettuce" level="WARN"/>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>

</configuration>
