<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Read log level from env; default to INFO -->
  <property name="LOG_LEVEL" value="${LOG_LEVEL:-INFO}"/>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <!-- Structured JSON lines — one JSON object per log event (NDJSON).
         All MDC fields (requestId, traceId, workspaceId, etc.) are merged into
         the root JSON object automatically by JsonLayout. -->
    <!-- One JSON object per line with a fixed envelope. The encoder lives in
         observability-kotlin so both services emit the same shape; each service
         previously had its own copy of this class and they had already diverged
         in field naming. -->
    <encoder class="com.vectorbea.observability.logging.JsonLogEncoder"/>
  </appender>

  <!-- Access log (request/response lines) -->
  <logger name="vectorbea.access" level="${LOG_LEVEL}" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>

  <!-- Application loggers -->
  <logger name="com.vectorbea" level="${LOG_LEVEL}" additivity="false">
    <appender-ref ref="STDOUT"/>
  </logger>

  <!-- Silence noisy JDK HttpServer internals -->
  <logger name="com.sun.net.httpserver" level="WARN"/>

  <!-- HikariCP — only log warnings by default -->
  <logger name="com.zaxxer.hikari" level="WARN"/>

  <!-- Lettuce — only log warnings by default -->
  <logger name="io.lettuce" level="WARN"/>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>

</configuration>
