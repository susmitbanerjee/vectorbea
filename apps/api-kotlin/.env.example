# =============================================================================
# apps/api-kotlin — Kotlin API environment variables
#
# Copy to .env for native local development:
#   cp apps/api-kotlin/.env.example apps/api-kotlin/.env
#
# Then load it before running:
#   export $(grep -v '^#' apps/api-kotlin/.env | xargs)
#   cd apps/api-kotlin && ./gradlew run
#
# Or use the root script:
#   npm run dev:api
#
# NEVER commit .env to git.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=development
APP_VERSION=0.1.0

# ── Database (JDBC URL — HikariCP) ────────────────────────────────────────────
# Local Docker postgres: jdbc:postgresql://localhost:5432/vectorbea
# Neon (production):     jdbc:postgresql://<host>.neon.tech/vectorbea?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/vectorbea
DB_POOL_MAX_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_KEEPALIVE_TIME_MS=300000
DB_MAX_LIFETIME_MS=1800000

# Run Flyway migrations on startup (set true in dev, use CI/CD in production)
RUN_MIGRATIONS=true

# ── Redis (Lettuce) ───────────────────────────────────────────────────────────
# Local Docker redis:  redis://localhost:6379
# Upstash (production): rediss://<token>@<host>.upstash.io:6380
REDIS_URL=redis://localhost:6379
REDIS_TLS_ENABLED=false
REDIS_COMMAND_TIMEOUT_MS=2000

# Queue / pub-sub channel names (must match worker)
REDIS_QUEUE_STREAM=workflow-runs
REDIS_QUEUE_GROUP=workflow-workers
REDIS_EVENT_CHANNEL_PREFIX=run-events
REDIS_CACHE_PREFIX=vectorbea
REDIS_LOCK_PREFIX=lock
REDIS_WORKER_HEARTBEAT_TTL_SECONDS=60

# ── Secret encryption ─────────────────────────────────────────────────────────
# 32-byte base64 key. Generate: openssl rand -base64 32
# NEVER use the placeholder in production.
SECRET_ENCRYPTION_KEY=dev-key-change-in-production-32b
SECRET_KEY_VERSION=1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins.
# Development: http://localhost:3000
# Production:  https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
# TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ── Request limits ────────────────────────────────────────────────────────────
MAX_REQUEST_BODY_BYTES=2097152
