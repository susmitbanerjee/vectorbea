# =============================================================================
# apps/worker-kotlin — Kotlin Worker environment variables
#
# Copy to .env for native local development:
#   cp apps/worker-kotlin/.env.example apps/worker-kotlin/.env
#
# Then load it before running:
#   export $(grep -v '^#' apps/worker-kotlin/.env | xargs)
#   cd apps/worker-kotlin && ./gradlew run
#
# Or use the root script:
#   npm run dev:worker:kotlin
#
# NEVER commit .env to git.
# =============================================================================

# ── Runtime environment ───────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0

# ── Worker identity ───────────────────────────────────────────────────────────
# Auto-generated from hostname + PID if not set. Set explicitly for stable IDs.
# WORKER_ID=worker-local-1
# WORKER_NAME=local-worker

# ── Database (JDBC URL — HikariCP) ────────────────────────────────────────────
# Local Docker postgres: jdbc:postgresql://localhost:5432/vectorbea
# Neon (production):     jdbc:postgresql://<host>.neon.tech/vectorbea?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/vectorbea
DB_POOL_MAX_SIZE=5
DB_CONNECTION_TIMEOUT_MS=30000

# ── Redis (Lettuce) ───────────────────────────────────────────────────────────
# Local Docker redis:  redis://localhost:6379
# Upstash (production): rediss://<token>@<host>.upstash.io:6380
REDIS_URL=redis://localhost:6379
REDIS_TLS_ENABLED=false
REDIS_COMMAND_TIMEOUT_MS=3000

# ── Secret encryption ─────────────────────────────────────────────────────────
# Must match the key used by the API service.
# Generate: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=dev-key-change-in-production-32b

# ── Queue configuration ───────────────────────────────────────────────────────
# Stream / group names must match the API service settings.
WORKER_QUEUE_STREAM=workflow-runs
WORKER_QUEUE_GROUP=workflow-workers

# Number of workflow runs to execute in parallel (1–32)
# Rule of thumb: set to (vCPUs × 2) for IO-heavy LLM workflows.
WORKER_CONCURRENCY=4

# How long XREADGROUP blocks before returning if no messages (ms)
WORKER_POLL_BLOCK_MS=5000

# Max messages per XREADGROUP poll
WORKER_POLL_BATCH_SIZE=10

# ── Heartbeat ─────────────────────────────────────────────────────────────────
# How often the worker writes its heartbeat to Redis (ms)
WORKER_HEARTBEAT_INTERVAL_MS=15000

# Redis TTL for the heartbeat key — must be > heartbeat interval
WORKER_HEARTBEAT_TTL_SECONDS=60

# ── Metrics HTTP server ───────────────────────────────────────────────────────
# Prometheus-compatible /metrics endpoint. Separate from API port.
METRICS_PORT=9090

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Provider capacity (§12.4) ─────────────────────────────────────────────────
# The shared token bucket in front of every provider call. OFF by default; it has
# never been enabled in any environment, which is why 429s reached production
# unmetered. Turn it on deliberately, after setting limits that match the
# provider account's own.
PROVIDER_CAPACITY_ENABLED=false

# Per-minute limits, in BOTH dimensions. Providers enforce requests and tokens
# separately, and an agent loop — many small calls — exhausts requests first.
# These defaults are conservative; set them from the provider's dashboard.
PROVIDER_RPM_DEFAULT=3000
PROVIDER_TPM_DEFAULT=1000000

# Per-model overrides, `provider[:model]=rpm/tpm`, comma-separated. Limits differ
# by an order of magnitude between models on the same account.
#   PROVIDER_LIMIT_OVERRIDES=anthropic:claude-opus-5=500/80000,openai:gpt-4o-mini=10000/2000000

# Salt for the credential fingerprint the bucket keys on.
#
# MUST be the same across every worker in a deployment. The fingerprint is what
# makes the ceiling per-ACCOUNT rather than per-workspace, so workers that
# disagree about the salt compute different keys for one credential and each
# silently gets a bucket of its own — which is the bug the account key fixes,
# reintroduced by a misconfiguration. Any long random string.
#   PROVIDER_CAPACITY_SALT=

# Fraction of bucket depth reserved for interactive lanes (batch stops here).
PROVIDER_CAPACITY_INTERACTIVE_FLOOR=0.2

# Fraction of depth a workspace must leave when BORROWING beyond its fair share.
# The fairness layer inside the account ceiling. Set to 0 when every workspace
# has its own credential, where the share is the whole bucket anyway.
PROVIDER_CAPACITY_BORROW_FLOOR=0.25

# How much of the per-minute limit is bucket depth rather than refill rate.
# depth + refill = the limit over any 60s window, whatever the arrival pattern.
PROVIDER_CAPACITY_BURST=0.2

# How long a reservation may stay outstanding before it returns itself. The
# backstop for a worker killed mid-call; release is the fast path.
PROVIDER_CAPACITY_LEASE_TTL_MS=120000

# ── Provider throttling ───────────────────────────────────────────────────────
# How far above a computed delay the retry jitter extends. A 60s Retry-After
# becomes a uniform draw across 60-90s. Without this, every caller a provider
# refuses in one second returns in the same instant.
PROVIDER_JITTER_SPREAD=0.5

# Fallback backoff when a 429 carries no Retry-After.
PROVIDER_BACKOFF_BASE_MS=1000
PROVIDER_BACKOFF_MAX_MS=300000

# Below this, backing off in place costs less than a suspend/resume round trip.
PROVIDER_SUSPEND_THRESHOLD_MS=2000
