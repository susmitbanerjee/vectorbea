{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/worker-kotlin/Dockerfile",
    "watchPatterns": ["apps/worker-kotlin/**", "packages/observability-kotlin/**", "packages/graph-kotlin/**"]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
