# =============================================================================
# apps/web — Next.js environment variables
#
# Copy to .env.local for native local development:
#   cp apps/web/.env.example apps/web/.env.local
#
# Production values (Vercel, Railway, etc.) are set via each platform's
# environment variable UI — never commit real secrets here.
# =============================================================================

# ── Kotlin API URL ────────────────────────────────────────────────────────────
# The Next.js frontend calls this URL for all product backend requests.
# Local native dev:   http://localhost:8080
# Docker full-stack:  http://api:8080  (set in docker-compose.yml)
# Production (Vercel): set NEXT_PUBLIC_VECTORBEA_API_URL in Vercel env vars
NEXT_PUBLIC_VECTORBEA_API_URL=http://localhost:8080

# ── Database (Neon / Postgres) ────────────────────────────────────────────────
# Neon (production / Vercel):
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/vectorbea?sslmode=require
# DIRECT_URL=postgresql://<user>:<password>@<host>.neon.tech/vectorbea?sslmode=require
#
# Local Docker:
DATABASE_URL=postgresql://vectorbea:vectorbea@localhost:5432/vectorbea
DIRECT_URL=postgresql://vectorbea:vectorbea@localhost:5432/vectorbea

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT secret — must match the value set in the Kotlin API (JWT_SECRET).
JWT_SECRET=change-me-in-production

# Set to "true" to require login on all protected routes.
REQUIRE_AUTH=false

# Supabase — used ONLY for OAuth federation (GitHub / Google / Microsoft).
# If you don't need social login, leave these as placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OAuth providers (optional — only needed for social login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ── Email (Resend) — optional ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@vectorbea.com

# ── Billing (LemonSqueezy) — optional ─────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
NEXT_PUBLIC_BILLING_PORTAL_URL=
