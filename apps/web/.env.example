# =============================================================================
# apps/web — Next.js environment variables
#
# Copy to .env.local for native local development:
#   cp apps/web/.env.example apps/web/.env.local
#
# When running via docker compose, env vars are injected directly.
# =============================================================================

# ── Kotlin API URL ────────────────────────────────────────────────────────────
# The Next.js frontend calls this URL for all product backend requests.
# Local native dev:   http://localhost:8080
# Docker full-stack:  http://api:8080  (set in docker-compose.yml)
# Production (Vercel): https://api.yourapp.com  (set in Vercel env vars)
NEXT_PUBLIC_VECTORBEA_API_URL=http://localhost:8080

# ── Database (Prisma — used only for auth/billing Next.js routes) ─────────────
# Local Docker:
DATABASE_URL=postgresql://vectorbea:vectorbea@localhost:5432/vectorbea?schema=vectorbea
DIRECT_URL=postgresql://vectorbea:vectorbea@localhost:5432/vectorbea?schema=vectorbea
# Neon (for Vercel deployment):
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/vectorbea?sslmode=require&schema=vectorbea
# DIRECT_URL=postgresql://<user>:<password>@<host>.neon.tech/vectorbea?sslmode=require&schema=vectorbea

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth (Supabase) ───────────────────────────────────────────────────────────
# Leave as placeholders to run in open/mock-session mode (no login required).
# Set real values + REQUIRE_AUTH=true to enable production authentication.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REQUIRE_AUTH=false

# ── Open / mock-session mode ──────────────────────────────────────────────────
# All API routes resolve to this org/user when auth is disabled.
MOCK_ORG_ID=org_acme_vectorbea_seed
MOCK_USER_ID=user_seed_owner_vectorbea

# ── Billing (LemonSqueezy) — optional ─────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
NEXT_PUBLIC_BILLING_PORTAL_URL=

# ── Email (Resend) — optional ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@vectorbea.com

# ── Slack notifications — optional ───────────────────────────────────────────
SLACK_WEBHOOK_URL=
