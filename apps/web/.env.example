# ─────────────────────────────────────────────────────────────────────────────
# Vectorbea Agent Scheduler — apps/web environment variables
# Copy to .env.local for local development.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Prisma / PostgreSQL) ────────────────────────────────────────────
# Required. Used by Prisma for all DB access and migrations.
# Local Docker:   postgresql://vectorbea:vectorbea@localhost:5432/vectorbea
# Supabase:       use the "Transaction Pooler" connection string (port 6543)
#                 append ?pgbouncer=true&connection_limit=1 for serverless
DATABASE_URL=postgresql://vectorbea:vectorbea@localhost:5432/vectorbea

# Direct connection required for Prisma migrations (not via pgBouncer)
# Same as DATABASE_URL when running locally without pooling.
DIRECT_URL=postgresql://vectorbea:vectorbea@localhost:5432/vectorbea

# ── Redis (BullMQ job queue backend) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Supabase (Auth) ───────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
# Only required for authentication; DB access goes through DATABASE_URL / Prisma.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Billing (LemonSqueezy) ────────────────────────────────────────────────────
# Get from: https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
NEXT_PUBLIC_BILLING_PORTAL_URL=

# ── Email (transactional — Resend recommended) ───────────────────────────────
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=noreply@vectorbea.com

# ── Slack notifications (optional) ───────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Internal security ─────────────────────────────────────────────────────────
# Shared secret for internal API route authentication (cron triggers, worker callbacks)
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ── IP Allowlist (optional — for staging/preview environments only) ───────────
# Comma-separated IPs. Leave blank to allow all.
# Automatically skipped when NODE_ENV=production.
WHITELISTED_IPS=
