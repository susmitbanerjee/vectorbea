{
  "name": "vectorbea-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{app,components,lib,src}/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"{app,components,lib,src}/**/*.{ts,tsx,css,md}\"",
    "check:boundaries": "node ../../scripts/check-forbidden-imports.mjs",
    "check:tokens": "node ../../scripts/check-design-tokens.mjs",
    "check:contrast": "node ../../scripts/check-contrast.mjs",
    "check:consistency": "node ../../scripts/check-consistency.mjs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "capture:storybook": "node tests/visual/capture-storybook.mjs",
    "test:visual:update": "playwright test --update-snapshots",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../../prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=../../prisma/schema.prisma",
    "prisma:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} ../../prisma/seed.ts",
    "prisma:studio": "prisma studio --schema=../../prisma/schema.prisma",
    "capture:docs": "node tests/visual/capture-docs.mjs",
    "capture:control": "node tests/visual/capture-control.mjs",
    "capture:runs": "node tests/visual/capture-runs.mjs",
    "perf:runs": "node tests/perf/runs-10k.mjs",
    "capture:run-detail": "node tests/visual/capture-run-detail.mjs",
    "capture:governance": "node tests/visual/capture-governance.mjs",
    "capture:workflows": "node tests/visual/capture-workflows.mjs",
    "capture:inspector": "node tests/visual/capture-inspector.mjs",
    "capture:architect": "node tests/visual/capture-architect.mjs",
    "check:fixtures": "node ../../scripts/check-fixtures.mjs"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} ../../prisma/seed.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next/mdx": "^16.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.49.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/pg": "^8.20.0",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^4.9.0",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.0.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.14.0",
    "motion": "^13.0.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.4",
    "pg": "^8.21.0",
    "prisma": "^5.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "stripe": "^18.4.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76",
    "@vectorbea/shared": "*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-themes": "^9.1.20",
    "@storybook/nextjs": "^9.1.20",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.1.0",
    "nodemailer": "^6.9.16",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
